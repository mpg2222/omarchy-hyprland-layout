#!/usr/bin/env bash
# omarchy-hyprland-layout — define and apply window layouts, from a screenshot
# or from your current desktop.
#
#   omarchy-hyprland-layout from-image <screenshot.png> [name]
#       Look at a screenshot of a desktop arrangement, detect every window
#       region, ask you which app belongs in each one, and save it as a
#       layout. Geometry is stored RELATIVE (percent of the screen), so the
#       same arrangement works on any monitor resolution.
#
#   omarchy-hyprland-layout save <name> [--all]
#       Snapshot every workspace on the active monitor (exact pixels;
#       --all includes every monitor).
#
#   omarchy-hyprland-layout restore <name>
#       Re-apply a saved layout: open windows are moved and placed at the
#       saved geometry; windows that are not open are launched with the
#       command recorded when the layout was defined, then placed.
#
#   omarchy-hyprland-layout list | delete <name>
#
#   omarchy-hyprland-layout bar [show | set <key> <value> | scale <percent> | reset]
#       Omarchy top bar height/icon sizes ([bar] in ~/.config/omarchy/shell.toml).
#       `save` records them in the layout and `restore` puts them back.
#
# Vision backend for from-image (any OpenAI-compatible endpoint):
#   OMARCHY_LAYOUT_VISION_URL    default http://127.0.0.1:1234/v1 (LM Studio)
#   OMARCHY_LAYOUT_VISION_MODEL  default: first model the endpoint serves
#
# Layouts live in ~/.local/state/omarchy/hyprland-layouts/<name>.json
set -uo pipefail

LAYOUTS_DIR="$HOME/.local/state/omarchy/hyprland-layouts"
mkdir -p "$LAYOUTS_DIR"
chmod 700 "$LAYOUTS_DIR" 2>/dev/null || true   # layouts contain window titles
VISION_URL="${OMARCHY_LAYOUT_VISION_URL:-http://127.0.0.1:1234/v1}"
VISION_MODEL="${OMARCHY_LAYOUT_VISION_MODEL:-}"

die() { echo "omarchy-hyprland-layout: $*" >&2; exit 1; }
ev() { hyprctl eval "$1" >/dev/null 2>&1; }
dsp() { ev "hl.dispatch(hl.dsp.$1)"; }
notify() { omarchy-notification-send -g "󱂬" "$1" 2>/dev/null || true; }

# Buffer hyprctl output before piping to jq (hyprwm#16206: closing the pipe
# early makes hyprctl abort with SIGABRT).
clients() { local out; out=$(hyprctl clients -j 2>/dev/null); printf '%s' "$out"; }
monitors() { local out; out=$(hyprctl monitors -j 2>/dev/null); printf '%s' "$out"; }
active_monitor() { monitors | jq -r 'first(.[] | select(.focused==true)) | .name'; }

valid_name() { [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]] || die "invalid layout name '$1' (letters, numbers, dot, dash, underscore)"; }

# ---------------------------------------------------------------- save
cmd_save() {
  local name="${1:-}"; shift || true
  valid_name "$name"
  local all=""; [[ "${1:-}" == "--all" ]] && all=1
  local amon; amon=$(active_monitor)
  [[ -n "$amon" ]] || die "could not read the active monitor"
  local amon_id; amon_id=$(monitors | jq -r --arg m "$amon" 'first(.[] | select(.name==$m)) | .id')
  [[ "$amon_id" =~ ^[0-9]+$ ]] || die "could not read the active monitor id"
  local monmap; monmap=$(monitors | jq '[.[] | {(.id|tostring): .name}] | add // {}')

  local file="$LAYOUTS_DIR/$name.json" tmp
  # private temp dir: window titles/classes must not be world-readable (0700)
  local tmpdir; tmpdir=$(mktemp -d)
  tmp="$tmpdir/win"
  # record each window's launch command from its pid so restore can relaunch
  # apps that are closed at restore time
  local cmdmap="$tmpdir/cmds"
  clients | jq -r '.[] | select(.pid != null) | "\(.pid)\t\(.initialClass)"' | sort -u > "$tmpdir/pids"
  : > "$cmdmap"
  while IFS=$'\t' read -r pid cls; do
    [[ -z "$pid" ]] && continue
    local cmd=""
    if [[ -r "/proc/$pid/cmdline" ]]; then
      # Use the actual executable; some apps replace argv[0] with a flattened
      # command line, which would otherwise be shell-quoted as one argument.
      local exe; exe=$(readlink -f "/proc/$pid/exe" 2>/dev/null || true)
      local -a argv=()
      mapfile -d '' -t argv < "/proc/$pid/cmdline"
      if [[ -n "$exe" ]]; then
        printf -v cmd '%q' "$exe"
        local i arg quoted
        if (( ${#argv[@]} == 1 )) && [[ "${argv[0]}" == "$exe "* ]]; then
          local -a flattened_args=()
          read -r -a flattened_args <<< "${argv[0]#"$exe "}"
          for arg in "${flattened_args[@]}"; do
            printf -v quoted '%q' "$arg"
            cmd+=" $quoted"
          done
        else
          for ((i=1; i<${#argv[@]}; i++)); do
            printf -v quoted '%q' "${argv[i]}"
            cmd+=" $quoted"
          done
        fi
      fi
    fi
    [[ -n "$cmd" ]] && printf '%s\t%s\n' "$pid" "$cmd" >> "$cmdmap"
  done < "$tmpdir/pids"
  local jqcmds
  jqcmds=$(jq -Rn '[inputs | split("\t") | {(.[0]): .[1]}] | add // {}' "$cmdmap")
  if [[ -n "$all" ]]; then
    monitors | jq '[.[] | {id, name, position: (.position // [.x, .y]), width, height}]' > "$tmp.mon"
    clients | jq --argjson cmds "$jqcmds" --argjson monmap "$monmap" '[.[] | select((.fullscreen|tonumber)==0) | {
      class: .initialClass, title, workspace: .workspace.id, monitor: ($monmap[(.monitor|tostring)] // .monitor),
      at, size, floating: (.floating==true), pinned: (.pinned==true),
      launch: ($cmds[(.pid|tostring)] // null)
    }]' > "$tmp.win"
  else
    monitors | jq --arg m "$amon" '[.[] | select(.name==$m) | {id, name, position: (.position // [.x, .y]), width, height}]' > "$tmp.mon"
    clients | jq --argjson m "$amon_id" --arg mname "$amon" --argjson cmds "$jqcmds" '[.[] | select(.monitor==$m and (.fullscreen|tonumber)==0) | {
      class: .initialClass, title, workspace: .workspace.id, monitor: $mname,
      at, size, floating: (.floating==true), pinned: (.pinned==true),
      launch: ($cmds[(.pid|tostring)] // null)
    }]' > "$tmp.win"
  fi
  jq -n --slurpfile mon "$tmp.mon" --slurpfile win "$tmp.win" --arg name "$name" \
     --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
     --argjson bar "$(bar_read)" --argjson displays "$(displays_json)" \
     '{version: 2, name: $name, savedAt: $ts, relative: false, monitors: $mon[0], windows: $win[0]}
      + (if ($bar | length) > 0 then {bar: $bar} else {} end)
      + {displays: ($displays | map({desc, name, x, y, scale, transform}))}' > "$file"
  rm -rf "$tmpdir"
  local n; n=$(jq '.windows | length' "$file")
  notify "Layout '$name' saved ($n windows)"
  echo "Layout '$name' saved ($n windows)."
}

# ------------------------------------------------------------- from-image
describe_pos() { # x y w h (0..1) -> human position
  local x=$1 y=$2 w=$3 h=$4
  local cx cy
  cx=$(awk -v v="$x" -v w="$w" 'BEGIN{printf "%.2f", v+w/2}')
  cy=$(awk -v v="$y" -v h="$h" 'BEGIN{printf "%.2f", v+h/2}')
  local col row
  if   awk -v v="$cx" 'BEGIN{exit !(v<0.34)}'; then col="left"
  elif awk -v v="$cx" 'BEGIN{exit !(v<0.67)}'; then col="center"
  else col="right"; fi
  if   awk -v v="$cy" 'BEGIN{exit !(v<0.34)}'; then row="top"
  elif awk -v v="$cy" 'BEGIN{exit !(v<0.67)}'; then row="middle"
  else row="bottom"; fi
  echo "$col-$row"
}

ask_vision() { # $1 = image path -> prints strict JSON {windows:[...]}
  local img="$1" model
  model="$VISION_MODEL"
  if [[ -z "$model" ]]; then
    model=$(curl -sf --max-time 10 "$VISION_URL/models" | jq -r '.data[0].id // empty')
  fi
  [[ -n "$model" ]] || die "no vision model available at $VISION_URL — set OMARCHY_LAYOUT_VISION_URL / OMARCHY_LAYOUT_VISION_MODEL"
  # downscale big captures (geometry is requested as fractions, so detail
  # loss is fine) and build the payload in a file: a 5K screenshot blows
  # the argv limit when passed inline.
  local vtmp; vtmp=$(mktemp -d)   # private: screenshot content
  local small="$vtmp/small.png"
  if command -v convert >/dev/null 2>&1; then
    convert "$img" -resize 1920x1080\> "$small" 2>/dev/null || cp "$img" "$small"
  else
    cp "$img" "$small"
  fi
  local b64file="$vtmp/b64" payload="$vtmp/payload" resp
  base64 -w0 "$small" > "$b64file"
  jq -n --arg m "$model" --rawfile b64 "$b64file" '{
    model: $m, temperature: 0,
    messages: [{role: "user", content: [
      {type: "text", text: "This is a screenshot of a Linux desktop with tiled windows. For EVERY visible window (ignore the taskbar/panel and wallpaper), report its bounding box as fractions of the full image (x,y,w,h between 0 and 1), a short guess of what kind of app it is, and any readable title-bar text. Reply with STRICT JSON only, no markdown fences: {\"windows\":[{\"x\":0,\"y\":0,\"w\":0,\"h\":0,\"guess\":\"\",\"title\":\"\"}]}"},
      {type: "image_url", image_url: {url: ("data:image/png;base64," + $b64)}}
    ]}]}
  ' > "$payload"
  resp=$(curl -sf --max-time 180 "$VISION_URL/chat/completions" \
    -H "Content-Type: application/json" --data-binary "@$payload") || { rm -rf "$vtmp"; die "vision request failed ($VISION_URL)"; }
  rm -rf "$vtmp"
  local content
  content=$(jq -r '.choices[0].message.content // empty' <<<"$resp")
  [[ -n "$content" ]] || die "vision model returned nothing"
  # strip possible code fences / prose around the object
  content=$(sed -n 's/.*\({.*windows.*}\).*/\1/p' <<<"$content" | head -1)
  jq -e '.windows | length > 0' <<<"$content" >/dev/null 2>&1 || die "could not detect windows in the image"
  printf '%s' "$content"
}

cmd_from_image() {
  local img="${1:-}" name="${2:-}"
  [[ -f "$img" ]] || die "image not found: $img"
  if [[ -z "$name" ]]; then
    read -rp "Layout name (no spaces): " name
  fi
  valid_name "$name"

  echo "Analyzing image..." >&2
  local spec; spec=$(ask_vision "$img")
  local n; n=$(jq '.windows | length' <<<"$spec")
  echo "Detected $n windows. Tell me which app belongs in each one." >&2
  echo "(type the app name if it is running — I will recognize it — or the command to launch it; Enter to skip)" >&2

  local ws; ws=$(hyprctl activeworkspace -j 2>/dev/null | cat | jq -r '.id')
  [[ "$ws" =~ ^[0-9]+$ ]] || ws=1   # keep --argjson happy if hyprctl gave nothing
  local out="$LAYOUTS_DIR/$name.json" tmp
  local tmpdir; tmpdir=$(mktemp -d)   # private: holds app names/classes
  tmp="$tmpdir/win"
  echo '[]' > "$tmp"

  local i
  for ((i=0; i<n; i++)); do
    local x y w h guess title pos
    x=$(jq -r --argjson i "$i" '.windows[$i].x' <<<"$spec")
    y=$(jq -r --argjson i "$i" '.windows[$i].y' <<<"$spec")
    w=$(jq -r --argjson i "$i" '.windows[$i].w' <<<"$spec")
    h=$(jq -r --argjson i "$i" '.windows[$i].h' <<<"$spec")
    guess=$(jq -r --argjson i "$i" '.windows[$i].guess // ""' <<<"$spec")
    title=$(jq -r --argjson i "$i" '.windows[$i].title // ""' <<<"$spec")
    pos=$(describe_pos "$x" "$y" "$w" "$h")
    # the model must return numbers; skip malformed entries instead of
    # poisoning the layout file
    if ! jq -e 'type=="number"' <<<"$x" >/dev/null 2>&1 || ! jq -e 'type=="number"' <<<"$y" >/dev/null 2>&1 || ! jq -e 'type=="number"' <<<"$w" >/dev/null 2>&1 || ! jq -e 'type=="number"' <<<"$h" >/dev/null 2>&1; then
      echo "  (window $((i+1)): invalid geometry from the model, skipped)" >&2
      continue
    fi
    local hint=""
    [[ -n "$guess" ]] && hint=" (looks like: $guess)"
    [[ -n "$title" ]] && hint="$hint — title: $title"

    local answer=""
    read -rp "Window $((i+1)) [$pos, ${w}x${h}]$hint → app: " answer
    [[ -z "$answer" ]] && continue

    # try to match a running window by class or title substring
    local cls=""
    cls=$(clients | jq -r --arg a "$(printf '%s' "$answer" | tr '[:upper:]' '[:lower:]')" \
      'first(.[] | select((.initialClass|ascii_downcase|contains($a)) or (.title|ascii_downcase|contains($a)))) | .initialClass')
    local entry
    if [[ -n "$cls" ]]; then
      entry=$(jq -n --arg c "$cls" --argjson x "$x" --argjson y "$y" --argjson w "$w" --argjson h "$h" --argjson ws "$ws" \
        '{class:$c, title:null, workspace:$ws, monitor:null, rel:[$x,$y,$w,$h], at:null, size:null, floating:false, pinned:false, launch:null}')
      echo "  → matched: $cls" >&2
    else
      entry=$(jq -n --arg c "$answer" --argjson x "$x" --argjson y "$y" --argjson w "$w" --argjson h "$h" --argjson ws "$ws" \
        '{class:null, title:null, workspace:$ws, monitor:null, rel:[$x,$y,$w,$h], at:null, size:null, floating:false, pinned:false, launch:$c}')
      echo "  → will launch with: $answer" >&2
    fi
    jq --argjson e "$entry" '. + [$e]' "$tmp" > "$tmp.new" && mv "$tmp.new" "$tmp"
  done

  local count; count=$(jq 'length' "$tmp")
  [[ "$count" -gt 0 ]] || { rm -rf "$tmpdir"; die "no apps assigned, layout not saved"; }
  jq -n --slurpfile win "$tmp" --arg name "$name" --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
     '{version: 2, name: $name, savedAt: $ts, relative: true, monitors: [], windows: $win[0]}' > "$out"
  rm -rf "$tmpdir"
  notify "Layout '$name' created from image ($count windows)"
  echo "Layout '$name' saved ($count windows, relative geometry — works at any resolution)."
  echo "Apply it with: omarchy-hyprland-layout restore $name"
}

# ------------------------------------------------------------- restore
place_window() { # $1=addr $2=x $3=y $4=w $5=h
  local addr=$1 x=$2 y=$3 w=$4 h=$5
  # Exact geometry requires floating: tiled windows are sized by the tiling
  # tree. A restored layout reproduces the arrangement pixel-for-pixel as
  # floating windows, which is what "copy this screenshot" means.
  # NOTE: window.float is a TOGGLE — only dispatch it when the window is
  # not already floating, or it would un-float it.
  # Hyprland 0.56 Lua API: move takes {x,y} position, resize takes {x,y} size.
  local is_float
  is_float=$(clients | jq -r --arg a "$addr" 'first(.[] | select(.address==$a)) | .floating')
  [[ "$is_float" == "false" ]] && { ev "hl.dispatch(hl.dsp.window.float({window='address:$addr'}))"; sleep 0.25; }
  ev "hl.dispatch(hl.dsp.window.fullscreen_state({window='address:$addr', internal=0, client=0}))"
  ev "hl.dispatch(hl.dsp.window.pin({window='address:$addr', action='unset'}))"
  ev "hl.dispatch(hl.dsp.window.resize({window='address:$addr', x=$w, y=$h}))"
  sleep 0.15
  ev "hl.dispatch(hl.dsp.window.move({window='address:$addr', x=$x, y=$y}))"
}

cmd_restore() {
  local name="${1:-}"; valid_name "$name"
  local workspace_filter=""
  if [[ "${2:-}" == "--workspace" ]]; then
    workspace_filter="${3:-}"
    [[ "$workspace_filter" =~ ^-?[0-9]+$ ]] || die "workspace must be a numeric workspace id"
  elif [[ -n "${2:-}" ]]; then
    die "usage: restore <name> [--workspace <id>]"
  fi
  local file="$LAYOUTS_DIR/$name.json"
  [[ -f "$file" ]] || die "no layout named '$name' (list them with: omarchy-hyprland-layout list)"
  local launch_dir; launch_dir=$(mktemp -d)   # temp launch scripts (private)
  trap 'rm -rf "$launch_dir"; trap - RETURN' RETURN

  local relative; relative=$(jq -r '.relative // false' "$file")

  # Saved top-bar size settings come back with a full restore (not --workspace).
  if [[ -z "$workspace_filter" ]] && jq -e '(.bar // {}) | length > 0' "$file" >/dev/null 2>&1; then
    local saved_bar; saved_bar=$(jq -c '.bar' "$file")
    [[ "$saved_bar" == "$(bar_read | jq -c .)" ]] || bar_write "$saved_bar"
  fi
  # ...and so does the monitor arrangement, when the saved screens are all here
  # and something differs (position, scale or rotation).
  if [[ -z "$workspace_filter" ]] && jq -e '(.displays // []) | length > 0' "$file" >/dev/null 2>&1; then
    local saved_disp live_disp
    saved_disp=$(jq -c '.displays' "$file")
    live_disp=$(displays_json)
    if jq -e --argjson live "$live_disp" '
        ($live | map({(.desc): .}) | add // {}) as $l |
        all(.[]; $l[.desc] != null) and
        any(.[]; ($l[.desc] | [.x, .y, .scale, .transform]) != [.x, .y, .scale, .transform])' <<<"$saved_disp" >/dev/null; then
      displays_apply "$saved_disp" >/dev/null || echo "Could not restore the display arrangement." >&2
      sleep 1
    fi
  fi

  # For relative layouts, resolve the target monitor now (the focused one).
  local m_x=0 m_y=0 m_w=0 m_h=0
  if [[ "$relative" == "true" ]]; then
    local amon; amon=$(active_monitor)
    [[ -n "$amon" ]] || die "could not read the active monitor"
    read -r m_x m_y m_w m_h < <(monitors | jq --arg m "$amon" -r 'first(.[] | select(.name==$m)) | "\(.position[0]) \(.position[1]) \(.width) \(.height)"')
  fi

  # 1. Pin saved workspaces to their monitors (absolute layouts only).
  if [[ "$relative" != "true" ]]; then
    local ws_id mon_name
    while IFS=$'\t' read -r ws_id mon_name; do
      [[ -z "$ws_id" || -z "$mon_name" || "$mon_name" == "null" ]] && continue
      if [[ "$mon_name" =~ ^[0-9]+$ ]]; then
        mon_name=$(monitors | jq -r --argjson id "$mon_name" 'first(.[] | select(.id==$id)) | .name')
        [[ -n "$mon_name" && "$mon_name" != "null" ]] || die "could not resolve saved monitor id for workspace $ws_id"
      fi
      dsp "workspace.move({workspace=$ws_id, monitor='$mon_name'})"
    done < <(jq -r --arg ws "$workspace_filter" '.windows[] | select($ws=="" or (.workspace|tostring)==$ws) | "\(.workspace)\t\(.monitor)"' "$file" | sort -u)
  fi

  # 2. Place each window.
  local total; total=$(jq '.windows | length' "$file")
  local used="[]"   # addresses already claimed by this layout: same-class
                    # windows must each match a DIFFERENT window
  local placements="[]"
  local missing="[]"
  local addr ws_id
  local k
  for ((k=0; k<total; k++)); do
    local wclass wtitle wws x y w h floating launch
    wclass=$(jq -r --argjson i "$k" '.windows[$i].class // empty' "$file")
    wtitle=$(jq -r --argjson i "$k" '.windows[$i].title // empty' "$file")
    wws=$(jq -r --argjson i "$k" '.windows[$i].workspace' "$file")
    launch=$(jq -r --argjson i "$k" '.windows[$i].launch // empty' "$file")
    # Older saves may contain a flattened argv[0] escaped as one shell word.
    local launch_exe="${launch%%\\ *}"
    if [[ "$launch" == "$launch_exe\\ --"* && -x "$launch_exe" ]]; then
      launch="${launch//\\ / }"
    fi
    floating=$(jq -r --argjson i "$k" '.windows[$i].floating // false' "$file")
    [[ -z "$workspace_filter" || "$wws" == "$workspace_filter" ]] || continue

    if [[ "$relative" == "true" ]]; then
      read -r x y w h < <(jq -r --argjson i "$k" --argjson mx "$m_x" --argjson my "$m_y" --argjson mw "$m_w" --argjson mh "$m_h" \
        '.windows[$i].rel as $r | "\(($mx + ($r[0]*$mw)|floor)) \(($my + ($r[1]*$mh)|floor)) \(($r[2]*$mw)|floor) \(($r[3]*$mh)|floor)"' "$file")
    else
      read -r x y < <(jq -r --argjson i "$k" '.windows[$i].at | "\(.[0]) \(.[1])"' "$file")
      read -r w h < <(jq -r --argjson i "$k" '.windows[$i].size | "\(.[0]) \(.[1])"' "$file")
    fi

    local addr=""
    if [[ -n "$wclass" ]]; then
      if [[ -n "$wtitle" ]]; then
        # the title goes to jq via a file descriptor, NOT --arg:
        # /proc/<pid>/cmdline is world-readable, so --arg would leak saved
        # window titles to any local user during restore
        addr=$(clients | jq -r --arg c "$wclass" --rawfile t <(printf '%s' "$wtitle") --argjson used "$used" \
          'first(.[] | select(((.initialClass|ascii_downcase|sub("-browser$"; ""))==($c|ascii_downcase|sub("-browser$"; "")) and .title==$t) and ((.address|tostring) as $a | ($used | index($a)) | not))) | .address')
      fi
      [[ -z "$addr" ]] && addr=$(clients | jq -r --arg c "$wclass" --argjson used "$used" \
        'first(.[] | select((.initialClass|ascii_downcase|sub("-browser$"; ""))==($c|ascii_downcase|sub("-browser$"; "")) and .workspace.id=='"$wws"' and ((.address|tostring) as $a | ($used | index($a)) | not))) | .address')
      [[ -z "$addr" ]] && addr=$(clients | jq -r --arg c "$wclass" --argjson used "$used" \
        'first(.[] | select((.initialClass|ascii_downcase|sub("-browser$"; ""))==($c|ascii_downcase|sub("-browser$"; "")) and ((.address|tostring) as $a | ($used | index($a)) | not))) | .address')
      if [[ -z "$addr" && -n "$launch" ]]; then
        # run the launch command through a temp script: Hyprland's exec
        # parser mangles shell metacharacters and quoting in the raw string
        local sfile="$launch_dir/w$k.sh"
        printf '#!/bin/sh\n%s\n' "$launch" > "$sfile"; chmod +x "$sfile"
        dsp "exec_cmd(\"[workspace $wws] $sfile\")"
        local t=0
        while (( t < 40 )); do
          addr=$(clients | jq -r --arg c "$wclass" --argjson used "$used" \
            'first(.[] | select((.initialClass|ascii_downcase|sub("-browser$"; ""))==($c|ascii_downcase|sub("-browser$"; "")) and ((.address|tostring) as $a | ($used | index($a)) | not))) | .address')
          [[ -n "$addr" ]] && break
          sleep 0.3; ((t++))
        done
      fi
    elif [[ -n "$launch" ]]; then
      # app unknown at save time: launch it, then grab the newest window
      local before; before=$(clients | jq -r '.[].address' | sort)
      local sfile2="$launch_dir/w2-$k.sh"
      printf '#!/bin/sh\n%s\n' "$launch" > "$sfile2"; chmod +x "$sfile2"
      dsp "exec_cmd(\"[workspace $wws] $sfile2\")"
      local t=0
      while (( t < 40 )); do
        addr=$(clients | jq -r --arg b "$before" '[.[] | .address] as $now | ($now - ($b | split("\n")))[0] // empty' <<<"$(clients)" 2>/dev/null)
        [[ -z "$addr" ]] && addr=$(comm -13 <(echo "$before") <(clients | jq -r '.[].address' | sort) | head -1)
        [[ -n "$addr" ]] && break
        sleep 0.3; ((t++))
      done
    fi
    if [[ -z "$addr" ]]; then
      missing=$(jq -c --arg c "$wclass" --arg t "$wtitle" --argjson ws "$wws" \
        '. + [{class:$c, title:$t, workspace:$ws}]' <<<"$missing")
      continue
    fi
    used=$(jq -c --arg a "$addr" '. + [$a]' <<<"$used")
    placements=$(jq -c --arg a "$addr" --argjson ws "$wws" '. + [{address:$a, workspace:$ws}]' <<<"$placements")

    dsp "window.move({window='address:$addr', workspace=$wws})"
    sleep 0.15
    place_window "$addr" "$x" "$y" "$w" "$h"
  done

  while IFS=$'\t' read -r addr ws_id; do
    [[ -n "$addr" && -n "$ws_id" ]] || continue
    ev "hl.dispatch(hl.dsp.window.move({window='address:$addr', workspace=$ws_id}))"
    ev "hl.dispatch(hl.dsp.window.pin({window='address:$addr', action='unset'}))"
  done < <(jq -r '.[] | "\(.address)\t\(.workspace)"' <<<"$placements")

  local missing_count; missing_count=$(jq 'length' <<<"$missing")
  if (( missing_count > 0 )); then
    jq -r '.[] | "workspace \(.workspace): \(.class) - \(.title)"' <<<"$missing" >&2
    notify "Layout '$name' partially restored ($missing_count window(s) missing)"
    echo "Layout '$name' partially restored ($missing_count window(s) missing)." >&2
    return 1
  fi
  notify "Layout '$name' restored"
  echo "Layout '$name' restored."
}

cmd_restore_last() {
  local newest="" f
  shopt -s nullglob
  for f in "$LAYOUTS_DIR"/*.json; do
    [[ -z "$newest" || "$f" -nt "$newest" ]] && newest="$f"
  done
  [[ -n "$newest" ]] || die "no layouts saved yet"
  cmd_restore "$(basename "$newest" .json)" "$@"
}

cmd_workspaces_last() {
  local newest="" f
  shopt -s nullglob
  for f in "$LAYOUTS_DIR"/*.json; do
    [[ -z "$newest" || "$f" -nt "$newest" ]] && newest="$f"
  done
  [[ -n "$newest" ]] || die "no layouts saved yet"
  jq -r '.windows | sort_by(.workspace) | group_by(.workspace)[] | "\(.[0].workspace)\t\(length)"' "$newest"
}

cmd_list() {
  shopt -s nullglob
  local found=0
  for f in "$LAYOUTS_DIR"/*.json; do
    found=1
    jq -r '"\(.name)  (\(.windows|length) windows, \(.savedAt))"' "$f"
  done
  [[ $found -eq 1 ]] || echo "No layouts yet. Create one with: omarchy-hyprland-layout from-image screenshot.png name"
}

cmd_delete() {
  local name="${1:-}"; valid_name "$name"
  local file="$LAYOUTS_DIR/$name.json"
  [[ -f "$file" ]] || die "no layout named '$name'"
  rm -f "$file"
  echo "Layout '$name' deleted."
}

# ------------------------------------------------------------------ bar
# Omarchy top-bar size settings live in the [bar] section of the machine-level
# ~/.config/omarchy/shell.toml (they override the theme's and survive theme
# changes; the shell hot-reloads the file). Only these keys are touched.
SHELL_TOML="${OMARCHY_SHELL_TOML:-$HOME/.config/omarchy/shell.toml}"
BAR_SIZE_KEYS=(size-horizontal size-vertical icon-slot icon-canvas icon-font icon-size status-slot)
declare -A BAR_DEFAULTS=([size-horizontal]=26 [size-vertical]=28 [icon-slot]=27 [icon-canvas]=16 [icon-font]=13 [icon-size]=12 [status-slot]=21)

valid_bar_key() {
  [[ "$1" == "scale-with-font" ]] && return 0
  local k; for k in "${BAR_SIZE_KEYS[@]}"; do [[ "$k" == "$1" ]] && return 0; done
  return 1
}

# [bar] section of shell.toml as a JSON object of strings (only known keys).
bar_read() {
  [[ -f "$SHELL_TOML" ]] || { echo '{}'; return; }
  awk '
    /^[[:space:]]*\[/ { inbar = ($0 ~ /^[[:space:]]*\[bar\][[:space:]]*$/); next }
    inbar && /^[[:space:]]*[A-Za-z-]+[[:space:]]*=/ {
      line = $0; sub(/[[:space:]]*#.*$/, "", line)
      split(line, kv, "="); k = kv[1]; v = kv[2]
      gsub(/[[:space:]"]/, "", k); gsub(/[[:space:]"]/, "", v)
      print k "\t" v
    }' "$SHELL_TOML" |
  while IFS=$'\t' read -r k v; do valid_bar_key "$k" && printf '%s\t%s\n' "$k" "$v"; done |
  jq -Rn '[inputs | split("\t") | {(.[0]): .[1]}] | add // {}'
}

# Replace the [bar] section with the given JSON object ({} removes it).
# Other sections and unknown [bar] keys are kept; the old file is backed up.
bar_write() {
  local json="$1" tmp
  mkdir -p "$(dirname "$SHELL_TOML")"
  [[ -f "$SHELL_TOML" ]] && cp -a "$SHELL_TOML" "$SHELL_TOML.bak.$(date +%s)"
  tmp=$(mktemp)
  local known; known=$(printf '%s|' "${BAR_SIZE_KEYS[@]}" scale-with-font); known=${known%|}
  {
    if [[ -f "$SHELL_TOML" ]]; then
      awk -v known="^[[:space:]]*($known)[[:space:]]*=" '
        /^[[:space:]]*\[/ { inbar = ($0 ~ /^[[:space:]]*\[bar\][[:space:]]*$/); if (inbar) { held = 1; next } }
        inbar && $0 ~ known { next }
        inbar && /^[[:space:]]*(#|$)/ { next }
        inbar { extra = extra $0 "\n"; next }
        { print }
        END { if (held) printf "%s", extra > "/dev/stderr" }' "$SHELL_TOML" 2>"$tmp.extra"
    fi
    if [[ "$json" != "{}" ]] || [[ -s "$tmp.extra" && -n "$(tr -d '[:space:]' < "$tmp.extra")" ]]; then
      echo "[bar]"
      jq -r 'to_entries[] | "\(.key) = \(.value)"' <<<"$json"
      [[ -s "$tmp.extra" ]] && grep -v '^[[:space:]]*$' "$tmp.extra"
    fi
  } > "$tmp"
  mv "$tmp" "$SHELL_TOML"; rm -f "$tmp.extra"
}

cmd_bar() {
  local sub="${1:-show}"; shift || true
  local cur; cur=$(bar_read)
  case "$sub" in
    show)
      local k v
      echo "Top bar settings ($SHELL_TOML):"
      for k in "${BAR_SIZE_KEYS[@]}"; do
        v=$(jq -r --arg k "$k" '.[$k] // empty' <<<"$cur")
        printf '  %-16s %-5s %s\n' "$k" "${v:-${BAR_DEFAULTS[$k]}}" "$([[ -n $v ]] && echo "(set; default ${BAR_DEFAULTS[$k]})" || echo "(default)")"
      done
      v=$(jq -r '.["scale-with-font"] // empty' <<<"$cur")
      printf '  %-16s %-5s\n' scale-with-font "${v:-true}" ;;
    set)
      local key="${1:-}" val="${2:-}"
      valid_bar_key "$key" || die "unknown bar key '$key' (one of: ${BAR_SIZE_KEYS[*]} scale-with-font)"
      if [[ "$key" == "scale-with-font" ]]; then
        [[ "$val" == "true" || "$val" == "false" ]] || die "scale-with-font must be true or false"
      else
        [[ "$val" =~ ^[0-9]+$ ]] && (( val >= 1 && val <= 200 )) || die "$key must be a whole number from 1 to 200"
      fi
      bar_write "$(jq -c --arg k "$key" --arg v "$val" '.[$k] = $v' <<<"$cur")"
      echo "Bar $key = $val" ;;
    scale)
      local pct="${1:-}"
      [[ "$pct" =~ ^[0-9]+$ ]] && (( pct >= 50 && pct <= 300 )) || die "usage: bar scale <percent 50-300> (100 = Omarchy default size)"
      local next="$cur" k v
      for k in "${BAR_SIZE_KEYS[@]}"; do
        v=$(( (BAR_DEFAULTS[$k] * pct + 50) / 100 ))
        next=$(jq -c --arg k "$k" --arg v "$v" '.[$k] = $v' <<<"$next")
      done
      bar_write "$next"
      echo "Bar scaled to ${pct}% of the Omarchy default."; cmd_bar show ;;
    grow)
      local delta="${1:-}"
      [[ "$delta" =~ ^[+-]?[0-9]+$ ]] && (( ${delta#+} >= -50 && ${delta#+} <= 100 )) || die "usage: bar grow <percent, e.g. 5 or -5>"
      delta=${delta#+}
      local next="$cur" k v
      for k in "${BAR_SIZE_KEYS[@]}"; do
        v=$(jq -r --arg k "$k" '.[$k] // empty' <<<"$cur"); v=${v:-${BAR_DEFAULTS[$k]}}
        v=$(( (v * (100 + delta) + 50) / 100 )); (( v < 1 )) && v=1
        next=$(jq -c --arg k "$k" --arg v "$v" '.[$k] = $v' <<<"$next")
      done
      bar_write "$next"
      echo "Bar grown by ${delta}%: height $(jq -r '.["size-horizontal"]' <<<"$next")px" ;;
    height)
      jq -r --arg d "${BAR_DEFAULTS[size-horizontal]}" '.["size-horizontal"] // $d' <<<"$cur" ;;
    reset)
      bar_write '{}'
      echo "Bar size settings removed; the theme's defaults apply again." ;;
    *) die "usage: bar [show | set <key> <value> | scale <percent> | grow <percent> | height | reset]" ;;
  esac
}

# ------------------------------------------------------------- displays
# Monitor arrangement. Rules are written by EDID description (not port), so a
# screen keeps its place whichever port or dock output it comes up on. They go
# in a marked "desk layout" block in ~/.config/hypr/monitors.lua; Display
# Switch's override file (which would beat monitors.lua) is set aside first.
MONITORS_LUA="${OMARCHY_MONITORS_LUA:-$HOME/.config/hypr/monitors.lua}"
DS_OVERRIDE="$HOME/.local/state/omarchy/toggles/hypr/display-switch.lua"
DESK_BEGIN="-- >>> desk layout (managed by Saved desktop layouts) >>>"
DESK_END="-- <<< desk layout <<<"

# Enabled monitors with logical (scaled, rotated) sizes.
displays_json() {
  monitors | jq -c '[.[] | select(.disabled != true) |
    (if (.transform % 2) == 1 then [.height, .width] else [.width, .height] end) as $wh |
    { name, desc: .description, x, y, scale, transform,
      w: (($wh[0] / .scale) | round), h: (($wh[1] / .scale) | round),
      internal: (.name | test("^(eDP|LVDS|DSI)")) }]'
}

# $1 = JSON array of {desc, name?, x, y, scale?, transform?}. Writes and reloads.
displays_apply() {
  local in="$1" cur
  jq -e 'type == "array" and length > 0 and all(.[];
      (.desc | type == "string" and test("^[A-Za-z0-9 ._()+-]+$")) and
      (.x | type == "number") and (.y | type == "number") and
      ((.name // "") | test("^[A-Za-z0-9._-]*$")))' <<<"$in" >/dev/null \
    || die "displays: expected [{desc, x, y}] with plain monitor descriptions"
  cur=$(displays_json)
  # Fill scale/transform/internal from the live monitor when not given.
  local rules
  rules=$(jq -r --argjson cur "$cur" '
    ($cur | map({(.desc): .}) | add // {}) as $live |
    (map(.x) | min) as $mx | (map(.y) | min) as $my |
    .[] | ($live[.desc] // {}) as $l |
    (.scale // $l.scale // 1) as $s | (.transform // $l.transform // 0) as $t |
    ((.name // $l.name // "") | test("^(eDP|LVDS|DSI)")) as $int |
    "hl.monitor({ output = \"" + (if $int then (.name // $l.name) else "desc:" + .desc end) +
    "\", mode = \"preferred\", position = \"" + ((.x - $mx) | round | tostring) + "x" + ((.y - $my) | round | tostring) +
    "\", scale = " + ($s | tostring) + ", transform = " + ($t | tostring) + " })"' <<<"$in") || die "displays: could not build rules"

  [[ -f "$MONITORS_LUA" ]] && cp -a "$MONITORS_LUA" "$MONITORS_LUA.bak.$(date +%s)"
  local tmp; tmp=$(mktemp)
  # Drop any earlier desk-layout block (old or new marker style), then append.
  awk '/^-- >>> desk layout/ {skip=1} !skip {print} /^-- <<< desk layout/ {skip=0; next}' "$MONITORS_LUA" 2>/dev/null \
    | sed -e :a -e '/^\n*$/{$d;N;ba' -e '}' > "$tmp"
  { printf '\n%s\n' "$DESK_BEGIN"; printf '%s\n' "$rules"; printf '%s\n' "$DESK_END"; } >> "$tmp"
  mv "$tmp" "$MONITORS_LUA"
  if [[ -f "$DS_OVERRIDE" ]]; then
    mv "$DS_OVERRIDE" "$MONITORS_LUA.display-switch.bak.$(date +%s)"
    echo "Set aside Display Switch's override (it would beat monitors.lua)."
  fi
  hyprctl reload >/dev/null 2>&1
  local errs; errs=$(hyprctl configerrors 2>/dev/null)
  [[ -z "$errs" || "$errs" == *"no errors"* ]] || { echo "$errs" >&2; die "Hyprland reported config errors (backup is next to monitors.lua)"; }
  echo "Displays arranged ($(jq length <<<"$in") screens)."
}

cmd_displays() {
  case "${1:-show}" in
    show|json) displays_json ;;
    apply)
      local arg="${2:-}"
      [[ "$arg" == "-" ]] && arg=$(cat)
      [[ -n "$arg" ]] || die "usage: displays apply '<json>' | -"
      displays_apply "$arg" ;;
    *) die "usage: displays [show | apply '<json>' | apply -]" ;;
  esac
}

# ----------------------------------------------------------------- idle
# Screensaver start and lock/display-off times (seconds; 0 = never). Omarchy
# turns the displays off a few seconds after the screen locks, so the lock time
# is the display-off time. Screensaver goes straight into idle.screensaver in
# shell.json. The plugged-in and battery lock times go into idle-power.json,
# which the idle-power-profile user service reads to pick idle.lock by power
# source; the current one is also written to shell.json right away.
SHELL_JSON="${OMARCHY_SHELL_JSON:-$HOME/.config/omarchy/shell.json}"
IDLE_PROFILE="${OMARCHY_IDLE_PROFILE:-$HOME/.config/omarchy/idle-power.json}"
IDLE_ADAPTER="${OMARCHY_IDLE_ADAPTER:-}"

on_ac() {
  local a
  if [[ -n "$IDLE_ADAPTER" ]]; then a="$IDLE_ADAPTER"
  else a=$(grep -l '^Mains$' /sys/class/power_supply/*/type 2>/dev/null | head -1); a=${a%/type}/online; fi
  [[ "$(cat "$a" 2>/dev/null)" == 1 ]]
}

shell_json_set() { # $1 = jq path expr, $2 = number
  [[ -f "$SHELL_JSON" ]] || echo '{}' > "$SHELL_JSON"
  local tmp; tmp=$(mktemp "$SHELL_JSON.XXXX") || return 1
  jq --argjson v "$2" "$1 = \$v" "$SHELL_JSON" > "$tmp" && chmod --reference="$SHELL_JSON" "$tmp" && mv "$tmp" "$SHELL_JSON"
}

idle_json() {
  local prof='{}'; [[ -f "$IDLE_PROFILE" ]] && prof=$(jq -c '.' "$IDLE_PROFILE" 2>/dev/null || echo '{}')
  local ac=false; on_ac && ac=true
  local service=false
  systemctl --user is-active --quiet idle-power-profile.service 2>/dev/null && service=true
  jq -c --argjson prof "$prof" --argjson ac "$ac" --argjson svc "$service" '{
      screensaver: (.idle.screensaver // 150),
      lock: (.idle.lock // 300),
      ac_lock: ($prof.ac_lock // (.idle.lock // 300)),
      battery_lock: ($prof.battery_lock // (.idle.lock // 300)),
      on_ac: $ac, service: $svc }' "$SHELL_JSON" 2>/dev/null || echo '{}'
}

cmd_idle() {
  case "${1:-show}" in
    show|json) idle_json ;;
    set)
      local which="${2:-}" secs="${3:-}"
      [[ "$secs" =~ ^[0-9]+$ ]] && (( secs <= 86400 )) || die "idle: seconds must be 0 (never) to 86400"
      case "$which" in
        screensaver) shell_json_set '.idle.screensaver' "$secs" || die "idle: could not write $SHELL_JSON" ;;
        ac-lock|battery-lock)
          local key=${which/-/_} prof='{}'
          [[ -f "$IDLE_PROFILE" ]] && prof=$(jq -c '.' "$IDLE_PROFILE" 2>/dev/null || echo '{}')
          local tmp; tmp=$(mktemp "$IDLE_PROFILE.XXXX") || die "idle: cannot write $IDLE_PROFILE"
          jq --arg k "$key" --argjson v "$secs" '.[$k] = $v' <<<"$prof" > "$tmp" && mv "$tmp" "$IDLE_PROFILE"
          # Apply now if it is the one for the current power source.
          if { [[ "$which" == ac-lock ]] && on_ac; } || { [[ "$which" == battery-lock ]] && ! on_ac; }; then
            shell_json_set '.idle.lock' "$secs" || die "idle: could not write $SHELL_JSON"
          fi ;;
        *) die "usage: idle set screensaver|ac-lock|battery-lock <seconds, 0 = never>" ;;
      esac
      echo "idle $which = $secs" ;;
    *) die "usage: idle [show | set screensaver|ac-lock|battery-lock <seconds>]" ;;
  esac
}

case "${1:-}" in
  from-image) shift; cmd_from_image "$@" ;;
  save)       shift; cmd_save "$@" ;;
  restore)    shift; cmd_restore "$@" ;;
  restore-last) shift; cmd_restore_last "$@" ;;
  workspaces-last) cmd_workspaces_last ;;
  list)       cmd_list ;;
  delete)     shift; cmd_delete "$@" ;;
  bar)        shift; cmd_bar "$@" ;;
  displays)   shift; cmd_displays "$@" ;;
  idle)       shift; cmd_idle "$@" ;;
  *) cat <<'EOF'
Usage:
  omarchy-hyprland-layout from-image <screenshot.png> [name]
      define a layout by pasting a screenshot of your desktop
  omarchy-hyprland-layout save <name> [--all]
      snapshot every workspace on the active monitor
  omarchy-hyprland-layout restore <name>
      apply a saved layout
  omarchy-hyprland-layout restore <name> --workspace <id>
      restore only one saved desktop (workspace)
  omarchy-hyprland-layout restore-last
      apply the most recently saved layout (used by the bar widget)
  omarchy-hyprland-layout workspaces-last
      list desktops in the most recently saved layout
  omarchy-hyprland-layout list | delete <name>
  omarchy-hyprland-layout bar [show]
      show the Omarchy top bar size settings
  omarchy-hyprland-layout bar set <key> <value>
      keys: size-horizontal size-vertical icon-slot icon-canvas
            icon-font icon-size status-slot scale-with-font
  omarchy-hyprland-layout bar scale <percent>
      resize bar + icons together (100 = Omarchy default)
  omarchy-hyprland-layout bar grow <percent>
      grow (or shrink, with -5) the bar + icons from their current size
  omarchy-hyprland-layout bar reset
      remove the overrides (theme defaults)
  omarchy-hyprland-layout displays
      list screens (JSON: desc, position, logical size, scale)
  omarchy-hyprland-layout displays apply '<json>'
      arrange screens: [{"desc": "...", "x": 0, "y": 0}, ...]
  omarchy-hyprland-layout idle
      screensaver and lock/display-off times (JSON, seconds)
  omarchy-hyprland-layout idle set screensaver|ac-lock|battery-lock <seconds>
      0 = never; ac/battery lock times feed the idle-power-profile service
EOF
    exit 1 ;;
esac
